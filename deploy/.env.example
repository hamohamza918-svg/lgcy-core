# LGCY Core — server environment.
#
# On a VM: copy to ".env" in the project root and fill in DISCORD_TOKEN.
# On Render: set these as Environment Variables in the dashboard (don't commit).

# --- Required ---------------------------------------------------------------
# Bot token: Discord Developer Portal → your app → Bot → Reset/Copy Token.
# NEVER commit this or paste it in chat.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Application (client) ID — same as the bot's user ID.
DISCORD_CLIENT_ID=1551593131877732513

# The LGCY server (guild) ID.
GUILD_ID=1534980236305891408

NODE_ENV=production
COMMAND_SCOPE=guild
LOG_LEVEL=info

# --- Channel seeds (recommended on Render / disk-less hosts) ----------------
# Render free has no persistent disk, so the config DB resets on every restart.
# These restore the welcome channels automatically on each boot.
WELCOME_CHANNEL_ID=1534981703393611907
RULES_CHANNEL_ID=1534981713300685024
ROLES_CHANNEL_ID=1550673783097139261

# Logging destinations per category (سجل-* channels + Decisions for moderation).
LOG_MEMBER_CHANNEL_ID=1534981638516248667
LOG_MESSAGE_CHANNEL_ID=1534981635311800421
LOG_ROLE_CHANNEL_ID=1534981660444069969
LOG_VOICE_CHANNEL_ID=1534981657159929937
LOG_SERVER_CHANNEL_ID=1534981664315408485
LOG_MODERATION_CHANNEL_ID=1534981678848671926

# --- Hosting ---------------------------------------------------------------
# PORT is REQUIRED for Render (it also injects this automatically) and enables
# the keep-alive HTTP endpoint that UptimeRobot pings. Leave unset on a VM.
# PORT=3000
