# ─────────────────────────────────────────────────────────────
#  LGCY CORE — environment configuration
#  Copy this file to `.env` and fill in the real values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Discord bot token (from the Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# Application (client) ID of the bot
DISCORD_CLIENT_ID=

# The guild (server) ID for LGCY.
# During development, slash commands are registered to this guild only
# (instant updates). Leave GUILD_ID set for the live server later.
GUILD_ID=

# Registration mode for slash commands: "guild" (instant, dev) or "global" (up to 1h propagation)
COMMAND_SCOPE=guild

# Logging
LOG_LEVEL=info          # trace | debug | info | warn | error | fatal
NODE_ENV=development    # development | production

# Database file (relative to project root)
DATABASE_PATH=data/lgcy-core.sqlite
